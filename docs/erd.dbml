Table store {
  id text [pk]
  name text [not null]
  category text [not null, note: 'BUNSIK | KOREAN_MEAL | GUKBAP | BANCHAN | BAKERY | OTHER']
  road_address text [not null]
  latitude float [note: '주소 지오코딩 결과, 행사 거리 계산 · 기상청 격자 변환용']
  longitude float
  business_hours json [not null, note: 'DayHours 7개 그대로']
  push_token text
  generation_status text [not null, default: 'GENERATING', note: 'GENERATING | READY']
  first_forecast_at timestamptz [note: '첫 예측이 만들어진 시각. FIRST_FORECAST 배너를 그날 홈에만 띄움']
  forecast_model json [note: '가게별 예측 모델. weights(요일·날씨 가중치), weekdayIndex(요일 경향), weatherIndex(메뉴별 기온·강수 경향), holdoutError, tunedDays, fittedAt. 판매 반영 뒤 다시 계산해 덮어씀']
  created_at timestamptz [not null, default: `now()`]
}

Table menu {
  id text [pk]
  store_id text [not null, ref: > store.id]
  name text [not null]

  indexes {
    (store_id, name) [unique]
  }

  Note: '메뉴 수량 단위는 모두 인분'
}

Table ingredient {
  id text [pk]
  store_id text [not null, ref: > store.id]
  name text [not null]
  unit text [not null, note: '개 | g. 레시피 · 재고 · 입고 · 발주 수량이 모두 이 단위']

  indexes {
    (store_id, name) [unique]
  }
}

Table recipe_item {
  menu_id text [not null, ref: > menu.id]
  ingredient_id text [not null, ref: > ingredient.id]
  quantity numeric [not null, note: '메뉴 1인분당 사용량 (재료 단위)']

  indexes {
    (menu_id, ingredient_id) [pk]
  }
}

Table sales_import {
  id text [pk]
  store_id text [not null, ref: > store.id]
  status text [not null, default: 'RECEIVED', note: 'RECEIVED | PARSING | NEEDS_CONFIRMATION | APPLYING | COMPLETED']
  file_path text [not null, note: 'confirm 이후 반영에 필요']
  pos_system text [note: 'TOSS_POS | OKPOS | BAEMIN_POS | OTHER']
  detection json [note: 'menuCount, columnMapping, preview']
  period_from date
  period_to date
  record_count int
  created_at timestamptz [not null, default: `now()`]
}

Table daily_sales {
  menu_id text [not null, ref: > menu.id]
  sold_on date [not null]
  quantity numeric [not null]

  indexes {
    (menu_id, sold_on) [pk]
  }
}

Table supplier {
  id text [pk]
  store_id text [not null, ref: > store.id]
  name text [not null]
  phone text
  phone_read_on date [note: '전화번호를 읽은 영수증 날짜 (11/8 영수증에서 읽었어요)']
  phone_confirmed bool [not null, default: false]
  order_days json [not null, default: '[]', note: 'DayOfWeek 배열']
  order_days_status text [not null, default: 'UNKNOWN', note: 'ESTIMATED | CONFIRMED | UNKNOWN']

  indexes {
    (store_id, name) [unique]
  }
}

Table receipt_scan {
  id text [pk]
  store_id text [not null, ref: > store.id]
  status text [not null, default: 'PROCESSING', note: 'PROCESSING | NEEDS_REVIEW | CONFIRMED']
  images json [not null, note: '올린 사진의 저장 위치 배열(올린 순서). 읽기 작업이 재시작돼도 다시 읽을 수 있게 함']
  result json [note: 'groups(+단가, 전화번호), questions, removedDuplicateTexts, 확정 답변']
  created_at timestamptz [not null, default: `now()`]
}

Table receipt_line {
  id int [pk, increment]
  store_id text [not null, ref: > store.id]
  source text [not null, default: 'RECEIPT', note: 'RECEIPT 영수증 확정 · MANUAL 사장님 수기 입고']
  is_stock_reset boolean [not null, default: false, note: 'true면 이 줄의 quantity를 그날의 재고로 보고 이전 장부를 무시 (MANUAL만)']
  supplier_id text [ref: > supplier.id, note: 'RECEIPT면 필수, MANUAL이면 null']
  purchased_on date [not null]
  ingredient_id text [not null, ref: > ingredient.id]
  product_name text [note: '영수증에 적힌 품명 (계란 특란 30구). RECEIPT면 필수. 발주 문구 · 같은 재료 판별용']
  quantity numeric [not null, note: '입고량 (재료 단위). 영수증의 포장량 × 수량을 개 또는 g으로 환산한 값. 재고 설정 줄만 0 허용']
  unit_price numeric [note: '재료 단위 1개(1개 또는 1g)당 원. RECEIPT는 영수증 줄 금액 ÷ 입고량, MANUAL은 사장님이 넣은 값(없으면 null)']

  Note: '입고 장부. 영수증 1장 = 같은 supplier_id · purchased_on 묶음. 재료의 현재 거래처는 RECEIPT 줄 중 purchased_on이 가장 늦은 줄, 현재 단가는 RECEIPT 줄과 단가 있는 MANUAL 줄 중 가장 늦은 줄. 남은 재고의 입고는 이 테이블만 계산'
}

Table forecast {
  menu_id text [not null, ref: > menu.id]
  target_date date [not null]
  recommended numeric [not null]
  baseline numeric [not null, note: '평소 수준. 최근 판매 수준 × 요일 경향']
  event_diff numeric [not null, default: 0]
  summary_text text
  previous_recommended numeric [note: '전날 밤 추천량과 달라졌을 때의 이전 값']
  adjusted numeric [note: '사장님이 고친 값']
  produced numeric [note: '만든 양. 화면 표시용이며 계산에 쓰지 않음']

  indexes {
    (menu_id, target_date) [pk]
  }
}

Table weather {
  store_id text [not null, ref: > store.id]
  target_date date [not null]
  temperature_c numeric [not null]
  condition text [not null, note: 'CLEAR | PARTLY_CLOUDY | CLOUDY | RAIN | SNOW | RAIN_SNOW | SHOWER']
  summary_text text [not null]
  change_text text [note: '밤사이 바뀌었으면 채움']

  indexes {
    (store_id, target_date) [pk]
  }

  Note: '대상일 예보. 홈 표시와 대상일 예측에 씀'
}

Table weather_observation {
  observed_on date [pk]
  max_temperature_c numeric [not null, note: '일 최고기온']
  precipitation_mm numeric [not null, note: '일 강수량. 비가 오지 않은 날은 0']

  Note: '서울 관측 지점 1곳의 과거 일별 관측값. 가게와 무관한 공통 자료. 예측 모델 계산에만 씀'
}

Table event {
  id text [pk, note: '서울 행사 API의 id']
  name text [not null]
  place text
  latitude float [not null]
  longitude float [not null]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  crowd_level text [note: 'NORMAL | BUSY | VERY_BUSY']
  expected_visitors int
  peak_from time
  peak_to time
  detail_url text
}

Table purchase_order {
  id text [pk]
  supplier_id text [not null, ref: > supplier.id]
  target_date date [not null]
  message_text text [not null]
  total_amount int [note: '생성 시점 금액']
  sent_channel text [note: 'SMS | KAKAOTALK | COPY']
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table purchase_order_line {
  purchase_order_id text [not null, ref: > purchase_order.id]
  ingredient_id text [not null, ref: > ingredient.id]
  quantity numeric [not null, note: '재료 단위']

  indexes {
    (purchase_order_id, ingredient_id) [pk]
  }

  Note: '입고로 계산하지 않음. 입고 예정 안내 문구용'
}

Table background_job {
  id text [pk]
  kind text [not null, note: 'GEOCODE_STORE | PARSE_SALES | APPLY_SALES | GENERATE_RECIPES | SCAN_RECEIPTS | FIT_FORECAST_MODEL | REFRESH_CONTEXT | GENERATE_FORECAST | SEND_PUSH']
  payload json [not null, note: '대상 store_id · import_id · scan_id · target_date 등']
  dedupe_key text [not null, unique, note: '같은 작업이 두 번 등록되지 않게 하는 키']
  state text [not null, default: 'READY', note: 'READY | RUNNING | SUCCEEDED | DEAD']
  attempts int [not null, default: 0]
  available_at timestamptz [not null, default: `now()`, note: '이 시각 이후에 실행. 재시도 지연에 사용']
  last_error text
  created_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  Note: '엑셀 반영 · 영수증 읽기 · 예측 모델 계산 · 예측 · 푸시 같은 비동기 작업. 서버가 재시작돼도 끝나지 않은 작업을 이어서 실행'
}

Table app_user {
  id text [pk]
  phone_number text [not null, unique, note: '로그인 아이디. 숫자만']
  password_hash text [not null, note: 'scrypt. salt_hex$hash_hex']
  store_id text [not null, unique, note: '가입 때 발급한 가게 id. store 행은 가게 정보 저장 때 생긴다']
  created_at timestamptz [not null, default: `now()`]
}
